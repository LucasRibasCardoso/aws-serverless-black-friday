# Copie para terraform.tfvars (ignorado pelo git) e ajuste se precisar.
aws_region   = "us-east-1"
project_name = "black-friday-lab"

tags = {
  Owner = "seu-nome"
}

# DynamoDB (limites de throughput On-Demand, em RRUs/s e WRUs/s)
dynamodb_max_read_request_units  = 12000
dynamodb_max_write_request_units = 4000
